// bbport: ray-traced AO, applied into the game's own AO mask after the game's AO pass: depth-aware
// upsample of the half-res trace, mask = min(mask, lerp(1, ao, strength)). The mask is the R8
// scene-size target of the temporal path, or with OUTPUT_RGBA the red channel of the half-size
// RGBA8 target of the cheaper path (the unmodded game, ticket 87; green, blue and alpha kept).
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D ao_tex;    // half res: ao, view z
layout(binding = 1) uniform texture2D depth_tex; // full res
#ifdef OUTPUT_RGBA
layout(binding = 2, rgba8) uniform image2D mask_img; // the game's half-size AO target, red channel
#else
layout(binding = 2, r8) uniform image2D mask_img; // the game's mask, read + write
#endif

layout(push_constant) uniform Constants {
    vec4 proj;
    vec2 full_size;
    vec2 half_size;
    float strength;
    uint debug;
    float power;      // ao = pow(ao, power)
    uint blur;        // 0: 2x2 bilinear upsample, 1: 4x4 tent (a small denoise)
    uint replace;     // 1: the mask becomes ours alone (the game's AO ignored)
    uint edge_fill;   // 1: few samples on this surface: the neighbourhood's AO instead of none
    uint mask_scale;  // 1: the mask is scene size; 2: half size (one mask texel per trace texel)
};

float ViewZ(float depth) { return proj.w / min(depth - proj.z, -1e-8); }

void main() {
    const ivec2 mp = ivec2(gl_GlobalInvocationID.xy); // the mask texel
    const int scale = int(mask_scale);
    const ivec2 mask_size = (ivec2(full_size) + scale - 1) / scale;
    if (mp.x >= mask_size.x || mp.y >= mask_size.y) {
        return;
    }
    // The scene pixel the mask texel stands for: itself, or at half size the pixel of its 2x2
    // block the trace samples (sub = 1, 1 as rtao_temporal.comp without subpixel).
    const ivec2 fp = min(mp * scale + (scale - 1), ivec2(full_size) - 1);
    const float depth = texelFetch(depth_tex, fp, 0).r;
    if (depth >= 1.0) {
        return;
    }
    const float z = ViewZ(depth);
    // In half-res texel coordinates: at scale 2 exactly the trace texel, the tent still smooths.
    const vec2 hpf = (vec2(mp) * float(scale) + 0.5 * float(scale)) / 2.0 - 0.5;
    const ivec2 h0 = ivec2(floor(hpf));
    const vec2 f = hpf - vec2(h0);
    float ao = 0.0, wsum = 0.0, wmatch = 0.0, around = 0.0, wbsum = 0.0;
    const int lo = blur != 0u ? -1 : 0, hi = blur != 0u ? 2 : 1;
    const float reach = blur != 0u ? 1.5 : 1.0; // tent radius in half-res texels
    for (int j = lo; j <= hi; ++j) {
        for (int i = lo; i <= hi; ++i) {
            const ivec2 hp = clamp(h0 + ivec2(i, j), ivec2(0), ivec2(half_size) - 1);
            const vec2 s = texelFetch(ao_tex, hp, 0).rg;
            const vec2 d = abs(vec2(h0 + ivec2(i, j)) - hpf);
            const float wb = max(reach - d.x, 0.0) * max(reach - d.y, 0.0);
            // Depth-aware, no bleeding across edges; the absolute term keeps the relief of
            // near cobbles (a few cm) from flipping neighbours in and out with the jitter.
            const float wd = exp(-abs(s.g - z) / (0.03 * z + 0.1));
            const float w = wb * wd + 1e-5;
            ao += s.r * w;
            wsum += w;
            wmatch += wb * wd;
            around += s.r * wb;
            wbsum += wb;
        }
    }
    // Few half-res texels on this surface (thin features: the sword): fade towards unoccluded
    // rather than a guess that flips every frame with the sampling (a hard switch flickered).
    // edge_fill: towards the AO around it instead (unoccluded drew a bright rim round thin
    // things and silhouettes against a darkened background); a blend of all the texels around,
    // which moves as slowly as they do.
    const float fallback = edge_fill != 0u ? around / max(wbsum, 1e-5) : 1.0;
    ao = mix(fallback, ao / wsum, clamp(wmatch / 0.3, 0.0, 1.0));
    ao = pow(clamp(ao, 0.0, 1.0), power);
    const vec4 old = imageLoad(mask_img, mp);
    const float game = old.r;
    const float ours = mix(1.0, ao, strength);
    const float value = debug != 0u ? ao : (replace != 0u ? ours : min(game, ours));
#ifdef OUTPUT_RGBA
    imageStore(mask_img, mp, vec4(value, old.gba));
#else
    imageStore(mask_img, mp, vec4(value, 0.0, 0.0, 0.0));
#endif
}

// bbport: ray-traced reflections, phase 1 (experimental, vk_rt_reflect.cpp). Runs right after the
// game's SSR pass (ps 6c2323c2) and works on its target (half resolution, RGBA16F: the reflected
// colour times a weight, the weight in alpha; zero where its march found nothing). Per texel a
// mirror ray goes into the ray-traced AO's scene; a hit the camera sees now (its projection lands
// on the screen and the depth there agrees) is shaded with last frame's lit image at the hit's
// reprojected position. The game's lighting pass then applies its own specular weighting, as it
// does to SSR. mode 1: only where SSR found nothing; mode 2: wherever the ray gives a value;
// mode 3: the game's SSR was left out (replace_ssr): its target is not read, every texel written
// (nothing where the ray gives no value).
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 4) in;

layout(binding = 0) uniform texture2D depth_tex;   // full res, D32 0..1 (this frame)
layout(binding = 1) uniform texture2D normal_tex;  // full res, world normal * 0.5 + 0.5
layout(binding = 2) uniform texture2D lit_prev;    // half res, last frame's lit opaque scene
layout(binding = 3, rgba16f) uniform image2D ssr_img; // the game's SSR target, read and written
layout(binding = 4) uniform accelerationStructureEXT scene; // the RTAO's TLAS (view space)
layout(binding = 5) uniform texture2D emission_tex; // quarter res, last frame's transparents' light
layout(binding = 6) uniform texture2D gloss_tex;    // full res, the G-buffer's c1: x the gloss (soften > 0)

layout(push_constant) uniform Constants {
    vec4 view[3];      // world -> view (this frame), 3x4 rows
    vec4 inv_view[3];  // view -> world (this frame)
    vec4 prev_view[3]; // world -> view (last frame)
    vec4 proj;         // this frame: x scale, y scale, z scale, z offset
    vec4 prev_proj;    // last frame
    vec2 full_size;    // pixels of the depth
    vec2 jitter;       // this frame's viewport shift, render pixels
    vec2 ssr_size;     // the SSR target
    vec2 lit_size;     // the lit copy
    float far;         // ray length, metres
    float strength;    // weight written with our colour (alpha)
    uint mode;         // 1 fill SSR misses, 2 ours wherever valid
    uint debug;        // 1 ours alone (SSR cleared), 2 classes: green ours, cyan surface cache, red hidden, blue miss, grey SSR kept
    uint surface_parts_count;
    float emission;    // x emission_tex (0: none bound)
    uint64_t surface_cache; // the RTAO's surface cache (0: none)
    uint64_t surface_parts;
    float soften;      // x the material's lobe: the ray's cone (0: a mirror)
    uint frame;
};

#include "rt_surface_lookup.glsl"

float ViewZ(float depth, vec4 p) {
    return p.w / min(depth - p.z, -1e-8);
}
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 ndc = (pixel - jitter) / full_size * 2.0 - 1.0;
    const float z = ViewZ(depth, proj);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
vec2 Project(vec3 v, vec4 p, vec2 size, vec2 shift) {
    const vec2 ndc = vec2(v.x * p.x / v.z, v.y * p.y / v.z);
    return (ndc * 0.5 + 0.5) * size + shift;
}
vec3 Rows(vec4 m[3], vec3 v) {
    const vec4 h = vec4(v, 1.0);
    return vec3(dot(m[0], h), dot(m[1], h), dot(m[2], h));
}

void main() {
    const ivec2 sp = ivec2(gl_GlobalInvocationID.xy);
    if (sp.x >= int(ssr_size.x) || sp.y >= int(ssr_size.y)) {
        return;
    }
    const vec4 ssr = mode == 3u ? vec4(0.0) : imageLoad(ssr_img, sp);
    const vec2 scale = full_size / ssr_size;
    const ivec2 fp = ivec2((vec2(sp) + 0.5) * scale);
    const float depth = texelFetch(depth_tex, fp, 0).r;
    if (depth >= 1.0) {
        if (mode == 3u) {
            imageStore(ssr_img, sp, vec4(0.0));
        }
        return; // sky: SSR wrote nothing to reflect there either
    }
    const vec3 P = ViewPos(vec2(fp) + 0.5, depth);
    const vec3 nw = normalize(texelFetch(normal_tex, fp, 0).xyz * 2.0 - 1.0);
    vec3 N = normalize(vec3(dot(view[0].xyz, nw), dot(view[1].xyz, nw), dot(view[2].xyz, nw)));
    const vec3 V = normalize(P);
    if (dot(N, V) > 0.0) {
        N = -N;
    }
    vec3 R = reflect(V, N);
    // Not every surface is a mirror: the game's lights give a material the specular power
    // 2^(13 gloss); its lobe (about sqrt(2 / (n + 2)) radians) x soften is the cone the ray is
    // spread over, a new direction each frame (the game's blurred SSR levels and the upscaler's
    // history average it).
    if (soften > 0.0) {
        const float n = exp2(13.0 * texelFetch(gloss_tex, fp, 0).x);
        const float cone = soften * sqrt(2.0 / (n + 2.0));
        const vec3 up = abs(R.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        const vec3 T = normalize(cross(up, R));
        const vec3 B = cross(R, T);
        const float a = 6.2831853 * fract(52.9829189 * fract(dot(vec2(sp) + float(frame % 16u) * 5.588238,
                                                                   vec2(0.06711056, 0.00583715))));
        const float r = sqrt(fract(52.9829189 * fract(dot(vec2(sp.yx) + float(frame % 16u) * 1.618034,
                                                          vec2(0.06711056, 0.00583715)))));
        const vec3 jittered = normalize(R + (T * cos(a) + B * sin(a)) * (tan(min(cone, 1.2)) * r));
        if (dot(jittered, N) > 0.0) {
            R = jittered;
        }
    }
    // Rays back towards the camera are left to SSR's own handling (it skips them too).
    const bool traced = dot(R, V) > 0.05;
    vec4 result = ssr;
    vec3 klass = vec3(0.5); // debug 2: grey = left as SSR made it
    if (traced && (mode >= 2u || ssr.a <= 0.0 || debug != 0u)) {
        rayQueryEXT q;
        const vec3 origin = P + N * (0.02 + 0.002 * length(P));
        rayQueryInitializeEXT(q, scene, gl_RayFlagsCullNoOpaqueEXT, 0xFF, origin, 0.0, R, far);
        while (rayQueryProceedEXT(q)) {
        }
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            klass = vec3(0.0, 0.0, 1.0);
            if (debug == 1u) {
                result = vec4(0.0);
            }
        } else {
            const vec3 H = origin + R * rayQueryGetIntersectionTEXT(q, true);
            const vec2 hp = Project(H, proj, full_size, jitter);
            bool visible = H.z * P.z > 0.0 && all(greaterThanEqual(hp, vec2(0.0))) &&
                           all(lessThan(hp, full_size));
            if (visible) {
                const float sz = ViewZ(texelFetch(depth_tex, ivec2(hp), 0).r, proj);
                visible = abs(sz - H.z) <= max(0.1, 0.03 * abs(H.z));
            }
            // Where the hit was last frame: its colour then.
            const vec3 Hprev = Rows(prev_view, Rows(inv_view, H));
            const vec2 pp = Project(Hprev, prev_proj, lit_size, vec2(0.0));
            visible = visible && Hprev.z * P.z > 0.0 && all(greaterThanEqual(pp, vec2(0.0))) &&
                      all(lessThan(pp, lit_size));
            vec3 L;
            if (visible) {
                // Fires and glows (blended after the opaque scene) from the emission image.
                L = texelFetch(lit_prev, ivec2(pp), 0).rgb +
                    texelFetch(emission_tex, ivec2(pp) / 2, 0).rgb * emission;
                klass = vec3(0.0, 1.0, 0.0);
            } else if (SurfaceRadiance(q, surface_cache, surface_parts, surface_parts_count, L)) {
                visible = true; // the surface cache saw it
                klass = vec3(0.0, 1.0, 1.0);
            }
            if (visible) {
                result = debug == 1u ? vec4(L, 1.0) : vec4(L * strength, strength);
            } else {
                klass = vec3(1.0, 0.0, 0.0);
                if (debug == 1u) {
                    result = vec4(0.0);
                }
            }
        }
    }
    if (debug == 2u) {
        result = vec4(klass, 1.0);
    }
    imageStore(ssr_img, sp, result);
}

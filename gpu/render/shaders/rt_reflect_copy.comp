// bbport: ray-traced reflections (vk_rt_reflect.cpp): the lit opaque scene of this frame, kept at
// half resolution (a 2x2 box) as the radiance next frame's reflection hits read.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D lit_tex;                    // full res, RGBA16F
layout(binding = 1, rgba16f) uniform writeonly image2D copy_img;  // half res

layout(push_constant) uniform Constants {
    ivec2 full_size;
    ivec2 half_size;
};

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (hp.x >= half_size.x || hp.y >= half_size.y) {
        return;
    }
    const ivec2 fp = min(hp * 2, full_size - 2);
    const vec3 c = texelFetch(lit_tex, fp, 0).rgb + texelFetch(lit_tex, fp + ivec2(1, 0), 0).rgb +
                   texelFetch(lit_tex, fp + ivec2(0, 1), 0).rgb + texelFetch(lit_tex, fp + ivec2(1, 1), 0).rgb;
    imageStore(copy_img, hp, vec4(c * 0.25, 1.0));
}

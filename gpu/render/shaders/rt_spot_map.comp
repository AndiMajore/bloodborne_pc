// bbport: a spot light's shadow map by ray tracing (spot_shadow= in rtao.txt, vk_rtao_spot.cpp).
// The game's shadowed spot (ps 82951fa5) samples a 512x512 variance shadow map: at its view ->
// light clip matrix's u = cx / cw * 0.5 + 0.5, v = -cy / cw * 0.5 + 0.5 the moments of the depth
// cw / range (cw: the distance along the light's axis), Chebyshev against its own. Here, per texel
// of a larger map, one ray from the light through the texel against the RTAO's scene: its first
// hit's depth and its square, the light passes sample this map in the game's place. Without a
// hit within the range: the range's end (lit). Modes 1 and 2: a separable Gaussian over `blur`
// texels (in_img -> map_img): a variance map's moments may be blurred, which softens the edges
// (the light is no point, and its source is mostly out of sight). After the blur the variance is
// capped (var_cap): where two casters overlap (the sword over the body), their mixed depths made
// a large variance, which Chebyshev reads as lit: a bright seam inside the shadow. The soft edge
// against the lit ground stays, it comes mostly from the blurred mean.
#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rg32f) uniform writeonly image2D map_img;
layout(binding = 1) uniform accelerationStructureEXT scene; // the RTAO's TLAS (view space)
layout(binding = 2, rg32f) uniform readonly image2D in_img;  // modes 1 and 2

layout(push_constant) uniform Constants {
    vec4 row_x;     // view (this frame) -> light clip, rows x, y and w
    vec4 row_y;
    vec4 row_w;
    vec3 light;     // view space
    float inv_range;
    float near;     // metres from the light the rays start (the lamp's own housing)
    uint size;
    uint mode;      // 0 trace, 1 blur x, 2 blur y
    int blur;       // texels
    float var_cap;  // the blurred variance's largest standard deviation (depth units); 0: none
};

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(size) || p.y >= int(size)) {
        return;
    }
    if (mode != 0u) {
        const ivec2 step_dir = mode == 1u ? ivec2(1, 0) : ivec2(0, 1);
        const float sigma = max(float(blur) * 0.5, 0.5);
        vec2 sum = vec2(0.0);
        float weight = 0.0;
        for (int i = -blur; i <= blur; ++i) {
            const ivec2 q = clamp(p + step_dir * i, ivec2(0), ivec2(int(size) - 1));
            const float w = exp(-0.5 * float(i * i) / (sigma * sigma));
            sum += imageLoad(in_img, q).xy * w;
            weight += w;
        }
        vec2 m = sum / weight;
        if (mode == 2u && var_cap > 0.0) {
            const float variance = max(m.y - m.x * m.x, 0.0);
            m.y = m.x * m.x + min(variance, var_cap * var_cap);
        }
        imageStore(map_img, p, vec4(m, 0.0, 0.0));
        return;
    }
    const vec2 uv = (vec2(p) + 0.5) / float(size);
    const float a = uv.x * 2.0 - 1.0, b = 1.0 - uv.y * 2.0;
    // The texel's ray: where cx = a cw and cy = b cw, two planes through the light.
    vec3 dir = normalize(cross(row_x.xyz - a * row_w.xyz, row_y.xyz - b * row_w.xyz));
    if (dot(row_w.xyz, dir) < 0.0) {
        dir = -dir;
    }
    rayQueryEXT q;
    // Foliage (non-opaque) left out, as for the AO.
    rayQueryInitializeEXT(q, scene, gl_RayFlagsCullNoOpaqueEXT, 0xFF, light, near, dir, 1.0 / inv_range);
    while (rayQueryProceedEXT(q)) {
    }
    float depth = 1.0;
    if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        const vec3 hit = light + dir * rayQueryGetIntersectionTEXT(q, true);
        depth = (dot(row_w.xyz, hit) + row_w.w) * inv_range;
    }
    imageStore(map_img, p, vec4(depth, depth * depth, 0.0, 0.0));
}

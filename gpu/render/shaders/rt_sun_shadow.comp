// bbport: the sun's shadow by ray tracing (sun_shadow= in rtao.txt, vk_rtao_sun.cpp). The game
// resolves its cascaded shadow map (4 taps, blocky up close) into a screen mask and the sun's
// light shader reads its z (z = scale * s + offset, s 1: lit). The mask pass draws two regions
// (stencil): in one the shadow goes to z (y = 1), in the other to y (z = 1, the global pass reads
// it); a pixel's region is told by which channel the game darkened, z where it is lit (both 1).
// Before the sun is drawn:
// mode 0, per pixel one ray towards the sun (a little spread: a soft edge, resolved by the
// upscaler's history) against the RTAO's scene. A hit is shadow. Without a hit the occluder may
// be beyond the RT scene (it holds the geometry near the camera; the game's cascades reach 150 m):
// the game's shadow then, shrunk by `erode` pixels (its blocky overhang beside near shadows goes,
// wide far shadows stay). Into vis_img.
// mode 1: vis_img into the mask's channel of the pixel's region (x: the AO, w stay). sun_debug 4:
// y and z zero (a test that the mask reaches the light passes).
// sun_half=1 (mode bit 8): mode 0 traces one pixel of each 2x2 (which one turns over 4 frames, the
// upscaler's history fills in) into a half-size vis_img; mode 1 takes the 2x2 half texels around
// the pixel, bilinear, each by how close its traced pixel's depth is (a silhouette does not blend).
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;  // full res, D32 0..1
layout(binding = 1) uniform texture2D normal_tex; // full res, world normal * 0.5 + 0.5
layout(binding = 2, rgba8) uniform image2D mask_img; // the game's shadow mask
layout(binding = 3, r8) uniform image2D vis_img;     // mode 0 out, mode 1 in
layout(binding = 4) uniform accelerationStructureEXT scene; // the RTAO's TLAS (view space)

layout(push_constant) uniform Constants {
    vec4 view[3];     // world -> view rows
    vec4 proj;
    vec2 full_size;
    vec2 jitter;
    vec3 sun;         // view space, towards the sun
    float spread;     // radians: the cone the rays are spread over
    vec4 region_a;    // the mask pass's regions: channel (1 y, 2 z), scale, offset (channel = scale s + offset)
    vec4 region_b;    // channel 0: none
    float erode;      // pixels
    float tmax;       // metres
    uint frame;
    uint mode;        // + debug << 4 (sun_debug: 1 the rays alone, no fallback; 2 the direction reversed;
                      // 8 the cached geometry alone; 16 the per-frame geometry seen from the camera:
                      // its distance against the depth buffer's, 0.5 the same),
                      // + 4096: half resolution
};

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 uv = (pixel - jitter) / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
float IGN(vec2 p) {
    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
}
// The region of a mask texel: B where B's channel is darkened and A's is not, else A.
vec4 Region(vec4 m) {
    if (region_b.x != 0.0 && m[int(region_b.x)] < 0.995 && m[int(region_a.x)] > 0.995) {
        return region_b;
    }
    return region_a;
}
float Decode(vec4 m, vec4 region) {
    return clamp((m[int(region.x)] - region.z) / region.y, 0.0, 1.0);
}
float GameShadow(ivec2 p) {
    const vec4 m = imageLoad(mask_img, clamp(p, ivec2(0), ivec2(full_size) - 1));
    return Decode(m, Region(m));
}

// sun_half: the full-res pixel a half texel traces this frame.
ivec2 HalfOffset() {
    return ivec2(frame & 1u, (frame >> 1u) & 1u);
}
ivec2 Traced(ivec2 hp) {
    return min(hp * 2 + HalfOffset(), ivec2(full_size) - 1);
}
// The visibility at a full-res pixel from the half-size image: the 2x2 half texels around it,
// bilinear, each by its traced pixel's depth against this one's (5 %: another surface counts not).
float HalfVisibility(ivec2 p, float z) {
    const ivec2 half_size = (ivec2(full_size) + 1) / 2;
    const vec2 f = (vec2(p - HalfOffset())) * 0.5;
    const ivec2 base = ivec2(floor(f));
    const vec2 t = f - vec2(base);
    float sum = 0.0, wsum = 0.0, nearest = 1.0, nearest_dz = 1e30;
    for (int i = 0; i < 4; ++i) {
        const ivec2 o = ivec2(i & 1, i >> 1);
        const ivec2 q = clamp(base + o, ivec2(0), half_size - 1);
        const float v = imageLoad(vis_img, q).r;
        const float dz = abs(ViewZ(texelFetch(depth_tex, Traced(q), 0).r) - z);
        const float w = (o.x == 1 ? t.x : 1.0 - t.x) * (o.y == 1 ? t.y : 1.0 - t.y) *
                        max(1.0 - dz / (0.05 * abs(z)), 0.0);
        sum += v * w;
        wsum += w;
        if (dz < nearest_dz) {
            nearest_dz = dz;
            nearest = v;
        }
    }
    return wsum > 1e-4 ? sum / wsum : nearest;
}

void main() {
    const bool half_res = (mode & 4096u) != 0u;
    const uint debug = (mode >> 4) & 31u;
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 out_p = p; // the vis texel written (mode 0)
    if ((mode & 15u) == 0u && half_res) {
        if (p.x >= (int(full_size.x) + 1) / 2 || p.y >= (int(full_size.y) + 1) / 2) {
            return;
        }
        p = Traced(p);
    }
    if (p.x >= int(full_size.x) || p.y >= int(full_size.y)) {
        return;
    }
    if ((mode & 15u) == 1u) {
        const float depth = texelFetch(depth_tex, p, 0).r;
        if (depth < 1.0) {
            vec4 m = imageLoad(mask_img, p);
            const vec4 region = Region(m);
            const float vis = half_res ? HalfVisibility(p, ViewZ(depth)) : imageLoad(vis_img, p).r;
            m[int(region.x)] = region.y * vis + region.z;
            if ((debug & 4u) != 0u) { // the write test: both channels in full shadow
                m.y = region_a.x == 1.0 ? region_a.z : 0.0;
                m.z = 0.0;
            }
            imageStore(mask_img, p, m);
        }
        return;
    }
    const float depth = texelFetch(depth_tex, p, 0).r;
    if (depth >= 1.0) {
        imageStore(vis_img, out_p, vec4(1.0));
        return;
    }
    const vec3 P = ViewPos(vec2(p) + 0.5, depth);
    const vec3 nw = normalize(texelFetch(normal_tex, p, 0).xyz * 2.0 - 1.0);
    vec3 N = normalize(vec3(dot(view[0].xyz, nw), dot(view[1].xyz, nw), dot(view[2].xyz, nw)));
    if (dot(N, -P) < 0.0) {
        N = -N;
    }
    float s;
    if ((debug & 16u) != 0u) {
        rayQueryEXT cq;
        rayQueryInitializeEXT(cq, scene, gl_RayFlagsCullNoOpaqueEXT, 0x01u, vec3(0.0), 0.0, normalize(P),
                              length(P) * 4.0);
        while (rayQueryProceedEXT(cq)) {
        }
        // Where the nearest per-frame hit lies against the depth buffer: 0.5 the same distance,
        // darker in front of the visible surface, brighter behind it; 1 no per-frame hit.
        s = rayQueryGetIntersectionTypeEXT(cq, true) != gl_RayQueryCommittedIntersectionNoneEXT
                ? clamp(0.5 + (rayQueryGetIntersectionTEXT(cq, true) / length(P) - 1.0) * 2.0, 0.0, 0.95)
                : 1.0;
        imageStore(vis_img, out_p, vec4(s));
        return;
    }
    const vec3 L = (debug & 2u) != 0u ? -sun : sun;
    if (dot(N, L) <= 0.0) {
        s = GameShadow(p); // facing away: the sun's own shading darkens it, as the game had it
    } else {
        // Off the surface by a little more than the depth buffer's error at this distance.
        const float dist = length(P);
        const vec3 origin = P + N * (0.02 + 0.002 * dist);
        const vec3 up = abs(L.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        const vec3 T = normalize(cross(up, L));
        const vec3 B = cross(L, T);
        const float a = 6.2831853 * IGN(vec2(p) + float(frame % 16u) * 5.588238);
        const float r = spread * sqrt(IGN(vec2(p.yx) + float(frame % 16u) * 1.618034));
        const vec3 dir = normalize(L + (T * cos(a) + B * sin(a)) * r);
        rayQueryEXT q;
        // Foliage (non-opaque) is left out, as for the AO: the game's shadow keeps it.
        // sun_debug 8: the cached (world-space) geometry alone, the per-frame left out.
        rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsCullNoOpaqueEXT,
                              (debug & 8u) != 0u ? 0x02u : 0xFFu,
                              origin, 0.0, dir, tmax);
        while (rayQueryProceedEXT(q)) {
        }
        if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            s = 0.0;
        } else if ((debug & 1u) != 0u) {
            s = 1.0;
        } else {
            // No occluder near: the game's, eroded (the brightest of a 3x3 at `erode` pixels) over
            // this surface only: a neighbour across a silhouette (another view depth) is another
            // surface's shadow, a lit fence would light the far wall seen between its bars.
            const int e = int(erode);
            s = GameShadow(p);
            for (int dy = -1; dy <= 1; ++dy) {
                for (int dx = -1; dx <= 1; ++dx) {
                    const ivec2 q = clamp(p + ivec2(dx, dy) * e, ivec2(0), ivec2(full_size) - 1);
                    const float zq = ViewZ(texelFetch(depth_tex, q, 0).r);
                    if (abs(zq - P.z) <= 0.05 * abs(P.z)) {
                        s = max(s, GameShadow(q));
                    }
                }
            }
        }
    }
    imageStore(vis_img, out_p, vec4(s));
}

// bbport: the fires as point lights for the RT SSGI (fire_light= in rtao.txt, vk_rtao_emission.cpp).
// One workgroup per 64x64 tile of the (blurred) emission image: the brightest texel is the
// light's place on screen, the nearest surface under the tile's bright flame its distance, pulled
// a little towards the camera (the flame burns in front of what it sits on). Its power is the
// tile's emission summed over the world area each texel covers at that distance, so a fire keeps
// its strength near and far. Out: per light two texels, the world position (w 1: a light, 0: none)
// and the power, blended with the tile's light of the frame before when it is near it
// (`smoothing`; flames flicker, the brightest texel wanders), faded in when new or moved.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform texture2D emit_tex;  // quarter size, the transparents' light
layout(binding = 1) uniform texture2D depth_tex; // full size, D32 0..1
layout(binding = 2, rgba32f) uniform image2D lights_img; // tiles x 2, last frame's in it

layout(push_constant) uniform Constants {
    vec4 inv_view[3]; // view -> world, 3x4 rows
    vec4 proj;
    vec2 full_size;
    vec2 jitter;
    ivec2 quarter_size;
    int tiles_x;
    float min_peak; // a tile's brightest texel must reach this
    float pull;     // metres towards the camera
    float smoothing; // 0..1: the share of last frame's light (0: none, a cut)
};

const int Tile = 64; // quarter-size texels; 16x16 invocations, 4x4 texels each
// fire_light 1: the burning stakes (Central Yharnam) visibly light the grass and fences around them.
const float Calibration = 32.0;

shared float s_peak[256];
shared uint s_pos[256];
shared vec3 s_sum[256];
shared float s_near[256];

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 uv = (pixel - jitter) / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
ivec2 FullPixel(ivec2 q) {
    return min(q * 4 + 2, ivec2(full_size) - 1);
}

void main() {
    const uint i = gl_LocalInvocationIndex;
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
    const ivec2 base = tile * Tile + ivec2(gl_LocalInvocationID.xy) * 4;
    float best = -1.0;
    ivec2 best_q = base;
    vec3 sum = vec3(0.0);
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            const ivec2 q = base + ivec2(x, y);
            if (any(greaterThanEqual(q, quarter_size))) {
                continue;
            }
            const vec3 e = texelFetch(emit_tex, q, 0).rgb;
            const float l = dot(e, vec3(0.2126, 0.7152, 0.0722));
            sum += e;
            if (l > best) {
                best = l;
                best_q = q;
            }
        }
    }
    s_peak[i] = best;
    s_pos[i] = uint(best_q.x) | (uint(best_q.y) << 16);
    s_sum[i] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (i < stride) {
            if (s_peak[i + stride] > s_peak[i]) {
                s_peak[i] = s_peak[i + stride];
                s_pos[i] = s_pos[i + stride];
            }
            s_sum[i] += s_sum[i + stride];
        }
        barrier();
    }
    // The depth: the nearest surface under the bright part of the flame anywhere in the tile (the
    // peak alone may fall into a gap between flame tongues, and a tile with only the tip of a
    // flame would put the light on the tree or house far behind it: its power grows with its
    // distance). Only flames over the sky: no light.
    const float bright = 0.25 * s_peak[0];
    float near_depth = 1.0;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            const ivec2 q = base + ivec2(x, y);
            if (any(greaterThanEqual(q, quarter_size)) ||
                dot(texelFetch(emit_tex, q, 0).rgb, vec3(0.2126, 0.7152, 0.0722)) < bright) {
                continue;
            }
            near_depth = min(near_depth, texelFetch(depth_tex, FullPixel(q), 0).r);
        }
    }
    s_near[i] = near_depth;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (i < stride) {
            s_near[i] = min(s_near[i], s_near[i + stride]);
        }
        barrier();
    }
    if (i != 0u) {
        return;
    }
    const ivec2 index = ivec2(tile.y * tiles_x + tile.x, 0);
    vec4 position = vec4(0.0), power = vec4(0.0);
    if (s_peak[0] >= min_peak) {
        const ivec2 q = ivec2(s_pos[0] & 0xFFFFu, s_pos[0] >> 16);
        // At the peak on screen, at the nearest depth under the flame.
        const ivec2 fp = FullPixel(q);
        const float depth = s_near[0];
        if (depth < 1.0) {
            vec3 v = ViewPos(vec2(fp) + 0.5, depth);
            const float len = length(v);
            v *= max(len - pull, 0.1) / len;
            const vec4 h = vec4(v, 1.0);
            position = vec4(dot(inv_view[0], h), dot(inv_view[1], h), dot(inv_view[2], h), 1.0);
            // A quarter-size texel's width and height in the world at this distance.
            const vec2 texel = 8.0 * abs(v.z) / (abs(proj.xy) * full_size);
            power = vec4(s_sum[0] * (texel.x * texel.y * Calibration), 0.0);
        }
    }
    if (smoothing > 0.0) {
        const vec4 prev_position = imageLoad(lights_img, index);
        const vec4 prev_power = imageLoad(lights_img, index + ivec2(0, 1));
        if (prev_position.w == 1.0) {
            if (position.w == 0.0) { // gone (or below min_peak) this frame: fades out
                position = prev_position;
                power = prev_power * smoothing;
            } else if (distance(prev_position.xyz, position.xyz) < 1.0) {
                position.xyz = mix(position.xyz, prev_position.xyz, smoothing);
                power = mix(power, prev_power, smoothing);
            } else { // jumped (another fire, or a wrong depth for a frame): fades in
                power *= 1.0 - smoothing;
            }
        } else if (position.w == 1.0) { // new: fades in
            power *= 1.0 - smoothing;
        }
    }
    imageStore(lights_img, index, position);
    imageStore(lights_img, index + ivec2(0, 1), power);
}

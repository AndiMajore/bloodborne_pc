// SPDX-License-Identifier: GPL-2.0-or-later
// bbport: the fires as lights for the RT SSGI (fire_light= in rtlighting.txt, vk_rt_emission.cpp;
// tickets 63, 67).
// Mode 0, one workgroup per 64x64 tile of the (blurred) emission image: the brightest texel is the
// light's place on screen. Its depth: from the bright texels within 2 quarter-size texels of the
// peak, the nearest depth that enough of them share (a fifth, at least 3, within 10 %), pulled a
// little towards the camera (the flame burns in front of what it sits on): not the nearest under
// any bright texel of the tile (a plant in front of one flame tongue pulled the light forward and
// a flicker pushed it back), not their median (through thin flame tongues that is the background).
// A peak whose line of sight passes a game fire light (an anchor, within base_merge sideways and 3 m
// in height) takes that light's distance instead: a pyre's thin, smoky flames show the wall behind
// or beside it through most texels, and a spark on that wall lit the wall from close by, with the
// power of a far fire (the power grows with the distance squared).
// Its power is the tile's emission summed over the world area each texel covers at that distance,
// so a fire keeps its strength near and far.
// Sticky lights (switch_ratio / hold > 0): the brightest texel wanders with the flicker and the
// light (and its shadows) jumped with it. The texel of the tile's last light (when it still lies in
// the tile) stays the peak unless this frame's brightest is switch_ratio brighter than the flame
// there, and for `hold` frames after a jump; it moves at once when the flame there went dark. Only
// the place on screen is kept: the depth is found again each frame (a light frozen in the world
// ended up behind its stake, all its shadow rays blocked).
// Mode 1, one invocation per light: a light within `merge` metres (horizontally) of a stronger one
// of this frame is dropped and its power added to the stronger (a tall flame over two tiles made two
// lights, the upper one popping in and out). The lights are matched with last frame's by their place
// in the world, not by tile (a fire crossing the screen changes tiles), blended with the nearest
// within reach (`smoothing` the power, `pos_smoothing` the place), faded in when new, faded out
// when gone and no light of this frame took it over. Per light three texels: the world position
// (w 1: a light, 0: none), the power (w: the distance from the camera), the frames since it moved.
// Mode 2, one invocation: the fires' steady bases, after the lights in the same rows (columns
// count..count+bases). Each base gathers this frame's lights near it sideways (base_merge,
// horizontally) even when their depth is off along the line of sight (up to half the camera's
// distance: a flicker puts a light on the stake one frame and on the wall behind the next), its
// summed power and place averaged over seconds (`base_smooth`; lights that agree in depth move the
// place ten times as much as the others); a light near no base starts one (faded in from nothing);
// a base whose fire is not on screen fades (`base_fade` a frame). A base lined up with one of the
// game's own fire lights (`anchors`, its light list) takes that light's place: exact and fixed.
// Large fires (the pyres): a base anchored to a game light the CPU marks as large (anchor w 1: a
// warm light of its fire brighter than fire_large) is large from then on (row 1's w of its slot);
// sparks near a large base (sideways within base_merge) are large too (row 2's y of their slot).
// Large ones take their own strength, lift and (in the gather) size.
// Then the list the gather reads: the lit lights (sparks) and bases, compacted, their power scaled
// (rows 3 and 4: position with w 1 a spark, 2 a base, 3 a large fire's spark, 4 a large base;
// power), their count in row 5. The gather loops over a handful of lights instead of every slot.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform texture2D emit_tex;  // quarter size, the transparents' light
layout(binding = 1) uniform texture2D depth_tex; // full size, D32 0..1
layout(binding = 2, rgba32f) uniform image2D raw_img;    // tiles x 2: this frame's (w 0.5: only above half the threshold)
layout(binding = 3, rgba32f) uniform readonly image2D prev_img;   // tiles x 2: last frame's lights
layout(binding = 4, rgba32f) uniform image2D lights_img; // (tiles + bases) x 6: this frame's lights, bases, the list

layout(push_constant) uniform Constants {
    vec4 inv_view[3]; // view -> world, 3x4 rows
    vec4 proj;
    vec2 full_size;
    vec2 jitter;
    ivec2 quarter_size;
    int tiles_x;
    float min_peak; // a tile's brightest texel must reach this
    float pull;     // metres towards the camera
    float smoothing; // 0..1: the share of last frame's power (0: none, a cut)
    float pos_smoothing; // 0..1: the share of last frame's position
    uint mode;       // 0: per tile into raw_img; 1: matched with last frame's; 2: the bases and the list
    uint count;      // lights (tiles)
    uint bases;      // base slots after the lights
    float base_smooth;
    float base_fade;
    float base_merge;
    float switch_ratio; // sticky lights: a new peak this much brighter than the flame at the light's place (0: off)
    float hold;         // sticky lights: frames a light stays after it moved
    float merge;        // metres: lights nearer than this (horizontally) merged into the strongest (0: off)
    float base_strength;  // the list: x a base's power
    uint anchor_count;    // mode 2: the game's own fire lights (its light list), nearest the camera first
    float spark_strength; // the list: x a spark's power
    float base_lift;      // the list: metres a base is moved up (the world's up is y)
    float large_base_strength, large_spark_strength, large_base_lift; // the list, large fires
    float pad;
    vec4 anchors[5];    // world position, w 1: a large fire's light
};

const uint MaxBases = 32u;

const int Tile = 64; // quarter-size texels; 16x16 invocations, 4x4 texels each
// fire_light 1: the burning stakes (Central Yharnam) visibly light the grass and fences around them.
const float Calibration = 32.0;

shared float s_peak[256];
shared uint s_pos[256];
shared vec3 s_sum[256];
shared float s_near[256];

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 uv = (pixel - jitter) / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
ivec2 FullPixel(ivec2 q) {
    return min(q * 4 + 2, ivec2(full_size) - 1);
}

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}
// The same light within 1 m or a fifth of its distance (a far fire's depth wobbles between its
// stake and what is behind).
float Reach(float camera_distance) {
    return max(1.0, 0.2 * camera_distance);
}

// The light's last place on this frame's screen: its quarter-size texel (x < 0: behind the camera).
ivec2 QuarterTexel(vec3 world) {
    // view = R^T (world - t), inv_view's rows being (R | t).
    const vec3 d = world - vec3(inv_view[0].w, inv_view[1].w, inv_view[2].w);
    const vec3 v = vec3(inv_view[0].x * d.x + inv_view[1].x * d.y + inv_view[2].x * d.z,
                        inv_view[0].y * d.x + inv_view[1].y * d.y + inv_view[2].y * d.z,
                        inv_view[0].z * d.x + inv_view[1].z * d.y + inv_view[2].z * d.z);
    if (abs(v.z) < 1e-3 || sign(v.z) != sign(ViewZ(0.5))) { // a visible point's z has a visible depth's sign
        return ivec2(-1);
    }
    const vec2 ndc = vec2(v.x * proj.x / v.z, v.y * proj.y / v.z);
    const vec2 pixel = (ndc * 0.5 + 0.5) * full_size + jitter;
    return ivec2(floor(pixel / 4.0));
}
// The flame's brightness around a quarter-size texel (its 3x3's brightest).
float FlameAt(ivec2 t) {
    float l = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = t + ivec2(dx, dy);
            if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, quarter_size))) {
                l = max(l, Luma(texelFetch(emit_tex, q, 0).rgb));
            }
        }
    }
    return l;
}

float Horizontal(vec3 a, vec3 b) {
    return length(a.xz - b.xz); // the world's up is y
}

void Match() {
    const uint i = gl_WorkGroupID.x * 256u + gl_LocalInvocationIndex;
    if (i >= count) {
        return;
    }
    const ivec2 index = ivec2(i, 0);
    vec4 raw_position = imageLoad(raw_img, index);
    vec4 raw_power = imageLoad(raw_img, index + ivec2(0, 1));
    if (merge > 0.0 && raw_position.w > 0.0) {
        const float mine = Luma(raw_power.rgb);
        vec3 added = vec3(0.0);
        for (uint j = 0u; j < count; ++j) {
            const vec4 r = imageLoad(raw_img, ivec2(j, 0));
            if (j == i || r.w <= 0.0 || Horizontal(r.xyz, raw_position.xyz) >= merge) {
                continue;
            }
            const vec3 q = imageLoad(raw_img, ivec2(j, 1)).rgb;
            const float theirs = Luma(q);
            if (theirs > mine || (theirs == mine && j < i)) {
                raw_position = vec4(0.0); // part of a stronger light: as if this tile had none
                break;
            }
            added += q;
        }
        raw_power.rgb += raw_position.w > 0.0 ? added : vec3(0.0);
    }
    vec4 position = vec4(0.0), power = vec4(0.0);
    float held = 0.0; // frames since the light last moved
    if (raw_position.w > 0.0) {
        // The nearest of last frame's lights within reach.
        float best = Reach(raw_power.w);
        int match = -1;
        for (uint j = 0u; smoothing > 0.0 && j < count; ++j) {
            const vec4 p = imageLoad(prev_img, ivec2(j, 0));
            const float d = distance(p.xyz, raw_position.xyz);
            if (p.w == 1.0 && d < best) {
                best = d;
                match = int(j);
            }
        }
        if (match >= 0) {
            const vec4 p = imageLoad(prev_img, ivec2(match, 0));
            const vec4 q = imageLoad(prev_img, ivec2(match, 1));
            position = vec4(mix(raw_position.xyz, p.xyz, pos_smoothing), 1.0);
            held = imageLoad(raw_img, index + ivec2(0, 2)).x;
            power = vec4(mix(raw_power.rgb, q.rgb, smoothing), raw_power.w);
        } else if (raw_position.w == 1.0) { // new (only above the full threshold): fades in
            position = vec4(raw_position.xyz, 1.0);
            power = vec4(raw_power.rgb * (1.0 - smoothing), raw_power.w);
        }
    } else if (smoothing > 0.0) {
        // None in this tile now: last frame's light here fades out, unless a light of this frame
        // (in another tile) is it.
        const vec4 p = imageLoad(prev_img, index);
        const vec4 q = imageLoad(prev_img, index + ivec2(0, 1));
        bool taken = p.w != 1.0;
        for (uint j = 0u; !taken && j < count; ++j) {
            const vec4 r = imageLoad(raw_img, ivec2(j, 0));
            taken = r.w > 0.0 && distance(r.xyz, p.xyz) < Reach(q.w);
        }
        if (!taken && Luma(q.rgb) * smoothing > 1e-4) {
            position = p;
            power = vec4(q.rgb * smoothing, q.w);
            held = imageLoad(prev_img, index + ivec2(0, 2)).x;
        }
    }
    imageStore(lights_img, index, position);
    imageStore(lights_img, index + ivec2(0, 1), power);
    imageStore(lights_img, index + ivec2(0, 2), vec4(held, 0.0, 0.0, 0.0));
}

// A light (or base) `p` against base `b` from the camera (`ray`: the unit direction to the base):
// x the sideways distance (horizontal), y the distance along the line of sight.
vec2 FromBase(vec3 b, vec3 ray, vec3 p) {
    const vec3 d = p - b;
    const float along = dot(d, ray);
    const vec3 side = d - along * ray;
    return vec2(length(side.xz), abs(along));
}
vec3 Camera() {
    return vec3(inv_view[0].w, inv_view[1].w, inv_view[2].w);
}

void Bases() {
    if (gl_GlobalInvocationID.x != 0u) {
        return;
    }
    const uint n = min(bases, MaxBases);
    vec3 position[MaxBases], power[MaxBases], sum_position[MaxBases], sum_power[MaxBases], ray[MaxBases];
    float weight[MaxBases], place_weight[MaxBases], reach[MaxBases];
    bool alive[MaxBases], fresh[MaxBases], large[MaxBases];
    for (uint b = 0u; b < n; ++b) {
        const ivec2 at = ivec2(count + b, 0);
        // smoothing 0: a cut (or the first frame), last frame's bases are not this frame's.
        const vec4 p = smoothing > 0.0 ? imageLoad(prev_img, at) : vec4(0.0);
        alive[b] = p.w == 1.0;
        fresh[b] = false;
        position[b] = p.xyz;
        const vec4 q = alive[b] ? imageLoad(prev_img, at + ivec2(0, 1)) : vec4(0.0);
        power[b] = q.rgb;
        large[b] = q.w > 0.5;
        sum_position[b] = vec3(0.0);
        sum_power[b] = vec3(0.0);
        weight[b] = 0.0;
        place_weight[b] = 0.0;
        // The line of sight to it and how far a light may be off along it, once per base.
        const vec3 to = p.xyz - Camera();
        ray[b] = to * inversesqrt(max(dot(to, to), 1e-6));
        reach[b] = max(base_merge, 0.5 * length(to));
    }
    for (uint i = 0u; i < count; ++i) {
        const vec4 p = imageLoad(lights_img, ivec2(i, 0));
        if (p.w != 1.0) {
            continue;
        }
        const vec3 q = imageLoad(lights_img, ivec2(i, 1)).rgb;
        const float w = Luma(q);
        if (w <= 0.0) {
            continue;
        }
        int nearest = -1;
        float best = 1e9;
        for (uint b = 0u; b < n; ++b) {
            if (!alive[b]) {
                continue;
            }
            const vec2 d = FromBase(position[b], ray[b], p.xyz);
            const float score = d.x + 0.25 * d.y;
            if (d.x < base_merge && d.y < reach[b] && score < best) {
                best = score;
                nearest = int(b);
            }
        }
        if (nearest < 0) { // a new fire: the first free slot
            for (uint b = 0u; b < n && nearest < 0; ++b) {
                if (!alive[b]) {
                    nearest = int(b);
                    alive[b] = fresh[b] = true;
                    large[b] = false;
                    position[b] = p.xyz;
                    power[b] = vec3(0.0);
                    const vec3 to = p.xyz - Camera();
                    ray[b] = to * inversesqrt(max(dot(to, to), 1e-6));
                    reach[b] = max(base_merge, 0.5 * length(to));
                }
            }
            if (nearest < 0) {
                continue; // more fires than slots
            }
        }
        // Its power in full; its place in full when it agrees in depth as well, else a tenth (one
        // frame's jump barely moves the base; a base started at a wrong depth still finds the fire).
        sum_power[nearest] += q;
        weight[nearest] += w;
        const float pw = fresh[nearest] || FromBase(position[nearest], ray[nearest], p.xyz).y < base_merge ? w : 0.1 * w;
        sum_position[nearest] += p.xyz * pw;
        place_weight[nearest] += pw;
    }
    for (uint b = 0u; b < n; ++b) {
        if (!alive[b]) {
            continue;
        }
        if (weight[b] > 0.0) {
            if (place_weight[b] > 0.0) {
                position[b] = fresh[b] ? sum_position[b] / place_weight[b]
                                       : mix(sum_position[b] / place_weight[b], position[b], base_smooth);
            }
            power[b] = mix(sum_power[b], power[b], base_smooth);
        } else {
            power[b] *= base_fade;
        }
        alive[b] = Luma(power[b]) > 1e-4 || fresh[b];
    }
    // A base lined up with one of the game's own fire lights takes that light's place: it is the
    // fire's, exact and fixed (the flame's depth is a guess that flickers between the stake and
    // what is behind it).
    for (uint b = 0u; b < n; ++b) {
        if (!alive[b]) {
            continue;
        }
        float best = 1e9;
        int anchor = -1;
        for (uint a = 0u; a < anchor_count; ++a) {
            const vec2 d = FromBase(position[b], ray[b], anchors[a].xyz);
            const float score = d.x + 0.25 * d.y;
            if (d.x < base_merge && d.y < reach[b] && score < best) {
                best = score;
                anchor = int(a);
            }
        }
        if (anchor >= 0) {
            position[b] = anchors[anchor].xyz;
            large[b] = anchors[anchor].w > 0.5;
        }
    }
    // Two bases that drifted onto one fire: the weaker joins the stronger.
    for (uint b = 0u; b < n; ++b) {
        for (uint c = b + 1u; c < n && alive[b]; ++c) {
            const vec2 d = FromBase(position[b], ray[b], position[c]);
            if (alive[c] && d.x < 0.5 * base_merge && d.y < reach[b]) {
                const bool keep_b = Luma(power[b]) >= Luma(power[c]);
                const uint keep = keep_b ? b : c, drop = keep_b ? c : b;
                power[keep] = max(power[keep], power[drop]);
                large[keep] = large[keep] || large[drop];
                alive[drop] = false;
            }
        }
    }
    for (uint b = 0u; b < n; ++b) {
        const ivec2 at = ivec2(count + b, 0);
        imageStore(lights_img, at, alive[b] ? vec4(position[b], 1.0) : vec4(0.0));
        imageStore(lights_img, at + ivec2(0, 1), alive[b] ? vec4(power[b], large[b] ? 1.0 : 0.0) : vec4(0.0));
    }
    // The gather's list: the lit sparks and bases, their power scaled.
    uint listed = 0u;
    for (uint i = 0u; i < count; ++i) {
        const vec4 p = imageLoad(lights_img, ivec2(i, 0));
        if (p.w != 1.0) {
            continue;
        }
        // A large fire's spark: near a large base sideways.
        bool big = false;
        for (uint b = 0u; b < n && !big; ++b) {
            big = alive[b] && large[b] && FromBase(position[b], ray[b], p.xyz).x < base_merge;
        }
        const vec4 held = imageLoad(lights_img, ivec2(i, 2));
        imageStore(lights_img, ivec2(i, 2), vec4(held.x, big ? 1.0 : 0.0, 0.0, 0.0));
        const vec3 q = imageLoad(lights_img, ivec2(i, 1)).rgb * (big ? large_spark_strength : spark_strength);
        if (Luma(q) > 0.0) {
            imageStore(lights_img, ivec2(listed, 3), vec4(p.xyz, big ? 3.0 : 1.0));
            imageStore(lights_img, ivec2(listed, 4), vec4(q, 0.0));
            ++listed;
        }
    }
    for (uint b = 0u; b < n; ++b) {
        const vec3 q = power[b] * (large[b] ? large_base_strength : base_strength);
        if (alive[b] && Luma(q) > 0.0) {
            const float lift = large[b] ? large_base_lift : base_lift;
            imageStore(lights_img, ivec2(listed, 3), vec4(position[b] + vec3(0.0, lift, 0.0), large[b] ? 4.0 : 2.0));
            imageStore(lights_img, ivec2(listed, 4), vec4(q, 0.0));
            ++listed;
        }
    }
    imageStore(lights_img, ivec2(0, 5), vec4(float(listed), 0.0, 0.0, 0.0));
}

void main() {
    if (mode == 1u) {
        Match();
        return;
    }
    if (mode == 2u) {
        Bases();
        return;
    }
    const uint i = gl_LocalInvocationIndex;
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
    const ivec2 base = tile * Tile + ivec2(gl_LocalInvocationID.xy) * 4;
    float best = -1.0;
    ivec2 best_q = base;
    vec3 sum = vec3(0.0);
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            const ivec2 q = base + ivec2(x, y);
            if (any(greaterThanEqual(q, quarter_size))) {
                continue;
            }
            const vec3 e = texelFetch(emit_tex, q, 0).rgb;
            const float l = dot(e, vec3(0.2126, 0.7152, 0.0722));
            sum += e;
            if (l > best) {
                best = l;
                best_q = q;
            }
        }
    }
    s_peak[i] = best;
    s_pos[i] = uint(best_q.x) | (uint(best_q.y) << 16);
    s_sum[i] = sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (i < stride) {
            if (s_peak[i + stride] > s_peak[i]) {
                s_peak[i] = s_peak[i + stride];
                s_pos[i] = s_pos[i + stride];
            }
            s_sum[i] += s_sum[i + stride];
        }
        barrier();
    }
    // The fallback depth: the nearest surface under the bright part of the flame anywhere in the
    // tile (the peak alone may fall into a gap between flame tongues, and a tile with only the tip
    // of a flame would put the light on the tree or house far behind it: its power grows with its
    // distance). Only flames over the sky: no light.
    const float bright = 0.25 * s_peak[0];
    float near_depth = 1.0;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            const ivec2 q = base + ivec2(x, y);
            if (any(greaterThanEqual(q, quarter_size)) ||
                dot(texelFetch(emit_tex, q, 0).rgb, vec3(0.2126, 0.7152, 0.0722)) < bright) {
                continue;
            }
            near_depth = min(near_depth, texelFetch(depth_tex, FullPixel(q), 0).r);
        }
    }
    s_near[i] = near_depth;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (i < stride) {
            s_near[i] = min(s_near[i], s_near[i + stride]);
        }
        barrier();
    }
    if (i != 0u) {
        return;
    }
    const ivec2 index = ivec2(tile.y * tiles_x + tile.x, 0);
    // Hysteresis: a light that is there goes out only below half the threshold (a small, far fire
    // hovers around it and would blink): w 0.5 continues a light only (mode 1).
    vec4 position = vec4(0.0), power = vec4(0.0);
    ivec2 q = ivec2(s_pos[0] & 0xFFFFu, s_pos[0] >> 16);
    float held = 0.0;
    if ((switch_ratio > 0.0 || hold > 0.0) && smoothing > 0.0 && s_peak[0] >= 0.5 * min_peak) {
        // smoothing > 0: last frame's lights are this one's predecessors (no cut).
        const vec4 p = imageLoad(prev_img, index);
        const ivec2 t = p.w == 1.0 ? QuarterTexel(p.xyz) : ivec2(-1);
        if (all(greaterThanEqual(t, tile * Tile)) && all(lessThan(t, min(tile * Tile + Tile, quarter_size)))) {
            const float here = FlameAt(t);
            const float since = imageLoad(prev_img, index + ivec2(0, 2)).x + 1.0;
            if (here >= 0.5 * min_peak && (since < hold || s_peak[0] <= here * (1.0 + switch_ratio))) {
                q = t;
                held = min(since, 1000.0);
            }
        }
    }
    if (s_peak[0] >= 0.5 * min_peak) {
        // At the peak on screen.
        const ivec2 fp = FullPixel(q);
        float depth = s_near[0]; // no well-supported depth around the peak: the tile's nearest
        {
            // The bright texels' depths around the peak, insertion-sorted (nearest first).
            const float bright = 0.25 * s_peak[0];
            float d[25];
            int n = 0;
            for (int dy = -2; dy <= 2; ++dy) {
                for (int dx = -2; dx <= 2; ++dx) {
                    const ivec2 p = q + ivec2(dx, dy);
                    if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, quarter_size)) ||
                        Luma(texelFetch(emit_tex, p, 0).rgb) < bright) {
                        continue;
                    }
                    const float z = texelFetch(depth_tex, FullPixel(p), 0).r;
                    int k = n++;
                    for (; k > 0 && d[k - 1] > z; --k) {
                        d[k] = d[k - 1];
                    }
                    d[k] = z;
                }
            }
            // The nearest depth with enough support: the median of its group.
            const int need = max(3, n / 5);
            for (int k = 0; k < n && d[k] < 1.0; ++k) {
                const float zk = ViewZ(d[k]);
                int m = 1;
                while (k + m < n && d[k + m] < 1.0 && abs(ViewZ(d[k + m]) - zk) <= 0.1 * abs(zk) + 0.1) {
                    ++m;
                }
                if (m >= need) {
                    depth = d[k + m / 2];
                    break;
                }
            }
        }
        if (depth < 1.0) {
            vec3 v = ViewPos(vec2(fp) + 0.5, depth);
            // A game fire light on the line of sight: the spark is at its distance.
            {
                const vec3 dir_view = normalize(v);
                const vec3 dir = vec3(dot(inv_view[0].xyz, dir_view), dot(inv_view[1].xyz, dir_view),
                                      dot(inv_view[2].xyz, dir_view));
                float best = base_merge, along = -1.0;
                for (uint a = 0u; a < anchor_count; ++a) {
                    const vec3 to = anchors[a].xyz - Camera();
                    const float t = dot(to, dir);
                    const vec3 off = dir * t - to; // the ray's point at the light's distance, from the light
                    const float side = length(off.xz);
                    if (t > 0.5 && side < best && abs(off.y) < 3.0) {
                        best = side;
                        along = t;
                    }
                }
                if (along > 0.0) {
                    v = dir_view * along;
                }
            }
            const float len = length(v);
            v *= max(len - pull, 0.1) / len;
            const vec4 h = vec4(v, 1.0);
            position = vec4(dot(inv_view[0], h), dot(inv_view[1], h), dot(inv_view[2], h),
                            s_peak[0] >= min_peak ? 1.0 : 0.5);
            // A quarter-size texel's width and height in the world at this distance.
            const vec2 texel = 8.0 * abs(v.z) / (abs(proj.xy) * full_size);
            power = vec4(s_sum[0] * (texel.x * texel.y * Calibration), len);
        }
    }
    imageStore(raw_img, index, position);
    imageStore(raw_img, index + ivec2(0, 1), power);
    imageStore(raw_img, index + ivec2(0, 2), vec4(held, 0.0, 0.0, 0.0));
}

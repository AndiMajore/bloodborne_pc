// bbport: ray-traced AO, static-cache probe (vk_rtao.cpp). One workgroup per draw of the frame's
// table: its captured vertices in world space, reduced to a count, centroid, bounding box and the
// first vertex. The host reads them back a few frames later; a draw whose summary stays the same
// over several frames is static and gets its own world-space BLAS.
#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

struct Geometry {
    uint store;
    uint vertices;
    uint instances;
    uint first_vertex;
    uint64_t index_address;
    uint index_count;
    uint index16;
    int base_vertex;
    uint restart;
    uint triangle_offset;
    uint triangles;
    uint out_base;
    uint flags;          // 2: probe this draw
};
struct Stats {
    uint id;
    uint count;
    float mean[3];
    float bmin[3];
    float bmax[3];
    float first[3];
    uint pad[2];
};
layout(binding = 0, std430) readonly buffer Geometries { Geometry geometries[]; };
layout(binding = 1, std430) writeonly buffer Out { Stats stats[]; };

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Positions { vec4 p[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint w[]; };

uint ReadIndex(Words words, uint index16, uint i) {
    if (index16 != 0u) {
        const uint j = i + ((index16 & 2u) != 0u ? 1u : 0u);
        const uint word = words.w[j >> 1];
        return (j & 1u) != 0u ? (word >> 16) : (word & 0xffffu);
    }
    return words.w[i];
}

layout(push_constant) uniform Constants {
    uint64_t positions_address;
    uint num_geometries;
    uint id;
    vec4 proj;
    vec4 inv_view[3];    // view -> world rows
};

shared vec3 s_sum[64];
shared vec3 s_min[64];
shared vec3 s_max[64];
shared uint s_count[64];

vec3 World(vec4 clip) {
    // The expand's view space (clip.w = view depth), then the game's inverse view.
    const vec4 v = vec4(clip.x / abs(proj.x), clip.y / abs(proj.y), clip.w, 1.0);
    return vec3(dot(inv_view[0], v), dot(inv_view[1], v), dot(inv_view[2], v));
}

void main() {
    const uint gi = gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationID.x;
    if (gi >= num_geometries) {
        return;
    }
    const Geometry g = geometries[gi];
    if ((g.flags & 2u) == 0u) {
        return;
    }
    Positions positions = Positions(positions_address);
    Words words = Words(g.index_address);
    // Only the vertices the indices use: the capture writes no others, and its unused slots hold
    // whatever an earlier draw left there.
    const uint restart_value = (g.index16 & 1u) != 0u ? 0xffffu : 0xffffffffu;
    const uint total = g.index_count * g.instances;
    vec3 sum = vec3(0.0), bmin = vec3(1e30), bmax = vec3(-1e30);
    uint count = 0u;
    for (uint n = lane; n < total; n += 64u) {
        const uint instance = n / g.index_count;
        const uint i = n - instance * g.index_count;
        const uint index = g.index_address != 0ul ? ReadIndex(words, g.index16, i) : i;
        if (g.restart != 0u && index == restart_value) {
            continue;
        }
        const int vertex = int(index) + g.base_vertex - int(g.first_vertex);
        if (vertex < 0 || uint(vertex) >= g.vertices) {
            continue;
        }
        const vec4 clip = positions.p[g.store + uint(vertex) + instance * g.vertices];
        if (any(isnan(clip)) || any(isinf(clip))) {
            continue;
        }
        const vec3 w = World(clip);
        sum += w;
        bmin = min(bmin, w);
        bmax = max(bmax, w);
        ++count;
    }
    s_sum[lane] = sum;
    s_min[lane] = bmin;
    s_max[lane] = bmax;
    s_count[lane] = count;
    barrier();
    for (uint step = 32u; step > 0u; step >>= 1) {
        if (lane < step) {
            s_sum[lane] += s_sum[lane + step];
            s_min[lane] = min(s_min[lane], s_min[lane + step]);
            s_max[lane] = max(s_max[lane], s_max[lane + step]);
            s_count[lane] += s_count[lane + step];
        }
        barrier();
    }
    if (lane == 0u) {
        const uint n = s_count[0];
        const vec3 c = n > 0u ? s_sum[0] / float(n) : vec3(0.0);
        // The first index's vertex (a vertex that is surely written).
        const uint i0 = g.index_address != 0ul ? ReadIndex(words, g.index16, 0u) : 0u;
        const int v0 = int(i0) + g.base_vertex - int(g.first_vertex);
        const vec4 c0 = (v0 >= 0 && uint(v0) < g.vertices) ? positions.p[g.store + uint(v0)] : vec4(0.0);
        const vec3 f = (any(isnan(c0)) || any(isinf(c0))) ? vec3(0.0) : World(c0);
        stats[gi].count = n;
        stats[gi].mean[0] = c.x; stats[gi].mean[1] = c.y; stats[gi].mean[2] = c.z;
        stats[gi].bmin[0] = s_min[0].x; stats[gi].bmin[1] = s_min[0].y; stats[gi].bmin[2] = s_min[0].z;
        stats[gi].bmax[0] = s_max[0].x; stats[gi].bmax[1] = s_max[0].y; stats[gi].bmax[2] = s_max[0].z;
        stats[gi].first[0] = f.x; stats[gi].first[1] = f.y; stats[gi].first[2] = f.z;
        stats[gi].id = id; // last: the host checks it to know the entry is this frame's
    }
}

// bbport: ray-traced AO, separable depth-aware blur of the half-res AO image (vk_rtao.cpp).
// Two dispatches (horizontal, vertical); each tap counts only where its view depth agrees.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D src_tex;             // half res: ao, view z
layout(binding = 1, rg16f) uniform writeonly image2D dst_img;

layout(push_constant) uniform Constants {
    vec2 half_size;
    ivec2 dir;        // (1,0) or (0,1)
    float sigma;      // taps' falloff in texels (0 = copy)
};

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (hp.x >= int(half_size.x) || hp.y >= int(half_size.y)) {
        return;
    }
    const vec2 c = texelFetch(src_tex, hp, 0).rg;
    if (sigma <= 0.0 || c.g >= 1e8) { // copy; sky
        imageStore(dst_img, hp, vec4(c, 0.0, 0.0));
        return;
    }
    float ao = c.r, wsum = 1.0;
    const int taps = 3;
    for (int k = -taps; k <= taps; ++k) {
        if (k == 0) {
            continue;
        }
        const ivec2 sp = clamp(hp + dir * k, ivec2(0), ivec2(half_size) - 1);
        const vec2 s = texelFetch(src_tex, sp, 0).rg;
        const float wg = exp(-float(k * k) / (2.0 * sigma * sigma));
        const float wd = exp(-abs(s.g - c.g) / (0.03 * c.g)); // same surface only
        const float w = wg * wd;
        ao += s.r * w;
        wsum += w;
    }
    imageStore(dst_img, hp, vec4(ao / wsum, c.g, 0.0, 0.0));
}

// bbport: ray-traced AO, the trace at half resolution (vk_rtao.cpp): cosine-weighted rays from the
// surface against the frame's acceleration structure (view space), distance falloff, temporal
// blend with the previous result reprojected by the camera motion vectors.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_ray_tracing_position_fetch : require
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;   // full res
layout(binding = 1) uniform texture2D normal_tex;  // full res, world normal * 0.5 + 0.5
layout(binding = 2) uniform texture2D motion_tex;  // full res, pixels, previous - current
layout(binding = 3) uniform texture2D prev_tex;    // half res, previous output
layout(binding = 4, rg16f) uniform writeonly image2D out_img; // half res: ao, view z
layout(binding = 5) uniform accelerationStructureEXT scene;

layout(push_constant) uniform Constants {
    vec4 view[3];     // world -> view rows
    vec4 proj;
    vec2 full_size;
    vec2 half_size;
    vec2 jitter;      // viewport shift in render pixels (unjitter the depth position)
    float radius;
    float history;
    uint rays;
    uint frame;
    uint mode;        // 2: primary-ray test t/|P| (0 = miss); 3: facing ratio of the normal;
                      // 4: AO with the rays starting 0.1 further out (self-hit test)
};

const float PI = 3.14159265;

float ViewZ(float depth) { return proj.w / min(depth - proj.z, -1e-8); }
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 uv = (pixel - jitter) / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
float IGN(vec2 p) { return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y)); }

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (hp.x >= int(half_size.x) || hp.y >= int(half_size.y)) {
        return;
    }
    const ivec2 fp = hp * 2 + 1;
    const float depth = texelFetch(depth_tex, fp, 0).r;
    if (depth >= 1.0) {
        imageStore(out_img, hp, vec4(1.0, 1e9, 0.0, 0.0));
        return;
    }
    const vec3 P = ViewPos(vec2(fp) + 0.5, depth);
    const vec3 nw = normalize(texelFetch(normal_tex, fp, 0).xyz * 2.0 - 1.0);
    vec3 N = normalize(vec3(dot(view[0].xyz, nw), dot(view[1].xyz, nw), dot(view[2].xyz, nw)));
    if (any(isnan(N)) || any(isnan(P)) || any(isinf(P))) { // no normal (sky, UI): nothing to trace
        imageStore(out_img, hp, vec4(1.0, 1e9, 0.0, 0.0));
        return;
    }
    if (mode == 3u) { // how much the stored normal faces the camera: ~1 expected on visible surfaces
        imageStore(out_img, hp, vec4(0.5 + 0.5 * dot(N, -normalize(P)), P.z, 0.0, 0.0));
        return;
    }
    if (dot(N, -P) < 0.0) {
        N = -N;
    }
    if (mode == 2u) {
        const float len = length(P);
        rayQueryEXT probe;
        rayQueryInitializeEXT(probe, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                              0xFF, vec3(0.0), 0.0, P / len, len * 1.5);
        while (rayQueryProceedEXT(probe)) {
        }
        float hit = 0.0;
        if (rayQueryGetIntersectionTypeEXT(probe, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            hit = rayQueryGetIntersectionTEXT(probe, true) / len; // ~1 when the BVH matches the depth
        }
        imageStore(out_img, hp, vec4(hit, P.z, 0.0, 0.0));
        return;
    }
    // Tangent frame around N.
    const vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 T = normalize(cross(up, N));
    const vec3 B = cross(N, T);
    // Snap the origin onto the BVH: the depth surface and the triangles disagree by a few
    // centimetres where the game draws with a depth bias (floor tiles), and rays that start
    // below their own surface hit it at once. One camera ray per pixel finds the real surface.
    vec3 origin = P;
    {
        const float len = length(P);
        rayQueryEXT snap;
        rayQueryInitializeEXT(snap, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT, 0xFF,
                              vec3(0.0), len * 0.8, P / len, len * 1.1);
        while (rayQueryProceedEXT(snap)) {
        }
        if (rayQueryGetIntersectionTypeEXT(snap, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            origin = P / len * rayQueryGetIntersectionTEXT(snap, true);
            // The triangle's own normal for the hemisphere: the shading normal (normal maps)
            // tilts rays into flat walls and floors.
            vec3 tri[3];
            rayQueryGetIntersectionTriangleVertexPositionsEXT(snap, true, tri);
            vec3 Ng = cross(tri[1] - tri[0], tri[2] - tri[0]);
            const float len_g = length(Ng);
            if (len_g > 1e-12) {
                Ng /= len_g;
                if (dot(Ng, -P) < 0.0) {
                    Ng = -Ng;
                }
                N = Ng;
            }
        }
    }
    origin += N * (0.01 + 0.001 * P.z);
    const float t_min = mode == 4u ? 0.1 : 0.0;
    const float n0 = IGN(vec2(fp) + float(frame % 8u) * 5.588238);
    const float n1 = IGN(vec2(fp.yx) + float(frame % 8u) * 1.618034);

    float occlusion = 0.0;
    for (uint r = 0u; r < rays; ++r) {
        // Cosine-weighted hemisphere, stratified by ray index.
        const float u = fract(n0 + float(r) / float(rays));
        const float v = fract(n1 + float(r) * 0.7548776662);
        const float phi = 2.0 * PI * v;
        const float cos_theta = sqrt(1.0 - u);
        const float sin_theta = sqrt(u);
        const vec3 dir = T * (cos(phi) * sin_theta) + B * (sin(phi) * sin_theta) + N * cos_theta;
        rayQueryEXT query;
        rayQueryInitializeEXT(query, scene,
                              gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT |
                                  gl_RayFlagsSkipClosestHitShaderEXT,
                              0xFF, origin, t_min, dir, radius);
        while (rayQueryProceedEXT(query)) {
        }
        if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            const float t = rayQueryGetIntersectionTEXT(query, true);
            occlusion += 1.0 - clamp(t / radius, 0.0, 1.0) * 0.5; // near hits count more
        }
    }
    float ao = 1.0 - occlusion / float(rays);

    // Temporal: last frame's value where this pixel was.
    const vec2 motion = texelFetch(motion_tex, fp, 0).rg;
    const ivec2 prev_hp = ivec2(floor((vec2(fp) + 0.5 + motion) / 2.0));
    if (all(greaterThanEqual(prev_hp, ivec2(0))) && all(lessThan(prev_hp, ivec2(half_size)))) {
        const vec2 prev = texelFetch(prev_tex, prev_hp, 0).rg;
        if (abs(prev.g - P.z) < 0.03 * P.z) {
            // Less history where the image moves fast (8 px of motion halves it): the shading
            // lagged behind the camera at 0.85.
            const float h = history * (1.0 - 0.5 * clamp(length(motion) / 8.0, 0.0, 1.0));
            ao = mix(ao, prev.r, h);
        }
    }
    imageStore(out_img, hp, vec4(ao, P.z, 0.0, 0.0));
}

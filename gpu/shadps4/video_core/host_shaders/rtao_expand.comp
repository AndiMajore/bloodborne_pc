// bbport: ray-traced AO, geometry expansion (vk_rtao.cpp). One invocation per output triangle:
// the draw's indices are read from the game's index buffer, the vertices' clip positions from the
// object-motion capture, and a flat view-space triangle list is written for the BLAS build.
#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

struct Geometry {
    uint store;          // positions base (vec4 index)
    uint vertices;       // vertices per instance in the capture
    uint instances;
    uint first_vertex;
    uint64_t index_address;
    uint index_count;    // per instance
    uint index16;        // 1: 16-bit indices
    int base_vertex;
    uint restart;        // 1: primitive restart on
    uint triangle_offset; // first output triangle of this geometry
    uint triangles;      // output triangles (index_count / 3 * instances)
    uint pad0, pad1;
};
layout(binding = 0, std430) readonly buffer Geometries { Geometry geometries[]; };
layout(binding = 1, std430) writeonly buffer Triangles { float vertices[]; }; // 9 floats per triangle

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer Positions { vec4 p[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Words { uint w[]; };

layout(push_constant) uniform Constants {
    uint64_t positions_address;
    vec4 proj;             // x scale, y scale, z scale, z offset (signed)
    uint num_geometries;
    uint total_triangles;
};

uint ReadIndex(Words words, uint index16, uint i) {
    if (index16 != 0u) {
        const uint j = i + ((index16 & 2u) != 0u ? 1u : 0u); // bit 1: the buffer starts mid-word
        const uint word = words.w[j >> 1];
        return (j & 1u) != 0u ? (word >> 16) : (word & 0xffffu);
    }
    return words.w[i];
}

void main() {
    const uint t = gl_GlobalInvocationID.x;
    if (t >= total_triangles) {
        return;
    }
    // The geometry of this triangle: binary search over the offsets.
    uint lo = 0u, hi = num_geometries - 1u;
    while (lo < hi) {
        const uint mid = (lo + hi + 1u) >> 1;
        if (geometries[mid].triangle_offset <= t) {
            lo = mid;
        } else {
            hi = mid - 1u;
        }
    }
    const Geometry g = geometries[lo];
    const uint local = t - g.triangle_offset;
    const uint tris_per_instance = g.index_count / 3u;
    const uint instance = local / tris_per_instance;
    const uint tri = local - instance * tris_per_instance;
    Words words = Words(g.index_address);
    Positions positions = Positions(positions_address);
    const uint restart_value = (g.index16 & 1u) != 0u ? 0xffffu : 0xffffffffu;
    vec3 out_pos[3];
    bool valid = true;
    for (uint k = 0u; k < 3u; ++k) {
        const uint index = ReadIndex(words, g.index16, tri * 3u + k);
        if (g.restart != 0u && index == restart_value) {
            valid = false;
            break;
        }
        const int vertex = int(index) + g.base_vertex - int(g.first_vertex);
        if (vertex < 0 || uint(vertex) >= g.vertices) {
            valid = false;
            break;
        }
        const vec4 clip = positions.p[g.store + uint(vertex) + instance * g.vertices];
        if (!(clip.w > 1e-4) || any(isnan(clip)) || any(isinf(clip))) {
            valid = false;
            break;
        }
        // The game's projection: clip.w is the view-space depth, clip.xy = view.xy * |scale|.
        out_pos[k] = vec3(clip.x / abs(proj.x), clip.y / abs(proj.y), clip.w);
        if (any(isnan(out_pos[k])) || any(isinf(out_pos[k])) || any(greaterThan(abs(out_pos[k]), vec3(1e5)))) {
            valid = false; // keeps infinities and absurd extents out of the BVH bounds
            break;
        }
    }
    const uint base = t * 9u;
    for (uint k = 0u; k < 3u; ++k) {
        const vec3 v = valid ? out_pos[k] : vec3(0.0); // degenerate: no hits
        vertices[base + k * 3u + 0u] = v.x;
        vertices[base + k * 3u + 1u] = v.y;
        vertices[base + k * 3u + 2u] = v.z;
    }
}

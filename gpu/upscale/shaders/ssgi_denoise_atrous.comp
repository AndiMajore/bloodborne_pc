// bbport: the RT bounce light's colour denoiser (rt_denoise=1 in ssgi.txt, experimental; tickets
// 36, 37, 42), its spatial half: one edge-avoiding a-trous pass (5x5 B3-spline taps, `step` apart)
// over the accumulated result, run 1-5 times with the step doubling. A tap counts by how close it
// lies to this texel's plane (its view position against this normal), how its normal agrees, and
// how its luminance differs measured in this texel's standard deviation: where the history is long
// and the variance small the filter keeps detail, where it is young it blurs. The first pass takes
// the variance from the temporal moments (young history: raised), each pass passes it on filtered;
// the last writes the gi image the apply pass reads (rgb, view z).
#version 460
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D in_tex;   // half res: rgb, frames (first pass) or variance
layout(binding = 1) uniform utexture2D mom_tex; // half res: moments, view z, normal (temporal pass)
layout(binding = 2, rgba16f) uniform writeonly image2D out_img; // rgb, variance (last: view z)

layout(push_constant) uniform Constants {
    vec4 view[3];     // world -> view, 3x4 rows (the normals are world space)
    vec4 proj;
    vec2 full_size;
    vec2 half_size;
    vec2 jitter;
    int step;         // texels between taps: 1, 2, 4 ...
    uint mode;        // 1: the first pass (variance from the moments), 2: the last (writes view z)
    float phi_luma;   // the luminance's tolerance in standard deviations
    float phi_plane;  // the plane distance's tolerance, a share of the view depth
    float phi_normal; // the normals' agreement: cos^phi_normal
};

float Luma(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}
vec2 OctWrap(vec2 v) {
    return (1.0 - abs(v.yx)) * vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}
vec3 UnpackNormal(uint p) {
    const vec2 e = unpackSnorm2x16(p);
    vec3 n = vec3(e, 1.0 - abs(e.x) - abs(e.y));
    if (n.z < 0.0) {
        n.xy = OctWrap(n.xy);
    }
    return normalize(n);
}
// A half-res texel's view position from its view z (the full-res pixel the gather used).
vec3 ViewPosZ(ivec2 hp, float z) {
    const vec2 uv = (vec2(hp * 2 + 1) + 0.5 - jitter) / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
float Variance(vec4 t, uvec4 m) {
    if ((mode & 1u) == 0u) {
        return t.a;
    }
    const float m1 = uintBitsToFloat(m.x), m2 = uintBitsToFloat(m.y);
    float v = max(m2 - m1 * m1, 0.0);
    // A history of a few frames: its moments say little, so blur more (SVGF estimates it
    // spatially instead; this is cheaper and errs towards smooth).
    if (t.a < 4.0) {
        v = max(v, m1 * m1) * 4.0 / max(t.a, 1.0);
    }
    return v;
}

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = ivec2(half_size);
    if (hp.x >= size.x || hp.y >= size.y) {
        return;
    }
    const uvec4 mc = texelFetch(mom_tex, hp, 0);
    const float zc = uintBitsToFloat(mc.z);
    const vec4 c = texelFetch(in_tex, hp, 0);
    if (zc > 1e8) {
        imageStore(out_img, hp, vec4(0.0, 0.0, 0.0, (mode & 2u) != 0u ? 1e9 : 0.0));
        return;
    }
    const vec3 nw = UnpackNormal(mc.w);
    const vec3 nc = vec3(dot(view[0].xyz, nw), dot(view[1].xyz, nw), dot(view[2].xyz, nw));
    const vec3 pc = ViewPosZ(hp, zc);
    const float lc = Luma(c.rgb);

    // The variance at this texel, smoothed over its 3x3 (one sample is too noisy to stop edges by).
    float var = 0.0, var_w = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = clamp(hp + ivec2(dx, dy), ivec2(0), size - 1);
            const float k = (dx == 0 ? 0.5 : 0.25) * (dy == 0 ? 0.5 : 0.25);
            var += Variance(texelFetch(in_tex, q, 0), texelFetch(mom_tex, q, 0)) * k;
            var_w += k;
        }
    }
    const float luma_scale = phi_luma * sqrt(max(var / var_w, 0.0)) + 1e-4;
    const float plane_scale = phi_plane * abs(zc) + 1e-3;

    const float kernel[3] = float[3](0.375, 0.25, 0.0625);
    vec3 sum = c.rgb * 0.140625; // kernel[0]^2
    float sum_w = 0.140625;
    float sum_var = Variance(c, mc) * 0.140625 * 0.140625;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            if (dx == 0 && dy == 0) {
                continue;
            }
            const ivec2 q = hp + ivec2(dx, dy) * step;
            if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, size))) {
                continue;
            }
            const uvec4 mq = texelFetch(mom_tex, q, 0);
            const float zq = uintBitsToFloat(mq.z);
            if (zq > 1e8) {
                continue;
            }
            const vec4 t = texelFetch(in_tex, q, 0);
            const float plane = abs(dot(nc, ViewPosZ(q, zq) - pc));
            const float wn = pow(max(dot(nw, UnpackNormal(mq.w)), 0.0), phi_normal);
            const float w = kernel[abs(dx)] * kernel[abs(dy)] * wn *
                            exp(-plane / plane_scale - abs(Luma(t.rgb) - lc) / luma_scale);
            sum += t.rgb * w;
            sum_w += w;
            sum_var += Variance(t, mq) * w * w;
        }
    }
    const vec3 rgb = sum / sum_w;
    imageStore(out_img, hp, vec4(rgb, (mode & 2u) != 0u ? zc : sum_var / (sum_w * sum_w)));
}

// bbport: ray-traced diffuse GI (SSGI with rt=1, experimental), gather at half resolution
// (vk_ssgi.cpp). Instead of marching the screen, cosine-weighted rays are traced against the
// ray-traced AO's scene (its TLAS, view space of this frame): a hit that the camera sees (its
// projection lands on the screen and the depth there agrees) contributes the lit colour at that
// pixel; a hit hidden from the camera or off screen contributes nothing yet (it still blocks the
// light from behind it, which the screen march could not know). Same output as ssgi_gather.comp,
// so the apply pass is shared. With a few rays a pixel the gather is far noisier than the march,
// so the reprojected history is clipped to this frame's 3x3 neighbourhood (mean +- k sigma, from
// the workgroup's tile): history from a moving character no longer trails as light.
// The fires (fire_light): the lights made from last frame's emission (rtao_fire_lights.comp), a
// compact list of sparks and steady bases; per ray one is picked by its unshadowed light and a
// shadow ray decides whether it reaches the pixel.
#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;   // full res, D32 0..1
layout(binding = 1) uniform texture2D normal_tex;  // full res, world normal * 0.5 + 0.5
layout(binding = 2) uniform texture2D color_tex;   // full res, lit opaque scene (RGBA16F)
layout(binding = 3) uniform texture2D motion_tex;  // full res, pixels, previous - current
layout(binding = 4) uniform texture2D prev_gi_tex; // half res, previous output
layout(binding = 5, rgba16f) uniform writeonly image2D gi_img; // half res: rgb gi, a view z
layout(binding = 6) uniform accelerationStructureEXT scene;   // the RTAO's TLAS (view space)
layout(binding = 7) uniform texture2D emission_tex; // quarter res, the transparents' light (last frame)
layout(binding = 8) uniform texture2D lights_tex;   // the fire lights' list: rows 3 (world position, w 1 a spark, 2 a base, 3 and 4 a large fire's) and 4 (power), its length in row 5

layout(push_constant) uniform Constants {
    vec4 view[3];     // world -> view, 3x4 rows
    vec4 proj;        // x scale, y scale, z scale, z offset
    vec2 full_size;   // pixels
    vec2 half_size;
    vec2 jitter;      // viewport shift in render pixels (as the RTAO's trace)
    float radius;     // world units: the ray length
    float history;    // 0..1 blend with the previous result
    uint frame;
    uint rays;        // per half-res pixel
    uint debug;       // 4: the fire lights alone; 3: the emission image; 2: rays whose hit was seen on screen (green), read from the surface cache (blue), hidden (red)
    uint surface_parts_count;
    float clip;       // history clipped to this frame's 3x3 mean +- clip sigma (plus a floor)
    float max_radiance; // per ray: brighter hits (lamps, candles) are scaled down to it (fireflies)
    float emission;     // x emission_tex, added after the cap (0: none bound)
    float fire_light;   // x the fire lights' light
    uint64_t surface_cache; // the RTAO's surface cache (0: none): radiance of hidden static hits
    uint64_t surface_parts;
    float fire_range;   // metres
    uint fire_count;    // 0: no fire lights bound
    float fire_wrap;    // 0..1: the cosine wrapped round (thin swaying leaves)
    float base_size;    // metres: a fire's steady base, its cylinder's radius
    float base_height;  // metres: its height, 40 % below the fire's place
    float spark_size;   // metres: a spark's sphere's radius
    uint fire_rays;     // shadow rays to the fires per pixel (at most rays)
    float large_base_size, large_base_height, large_spark_size; // large fires (the pyres)
    float pad;
};

#include "../../render/shaders/rt_surface_lookup.glsl"

const float PI = 3.14159265;

float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 uv = (pixel - jitter) / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
// The full-res pixel a view-space point projects to (ViewPos inverted).
vec2 ScreenPos(vec3 v) {
    const vec2 ndc = vec2(v.x * proj.x / v.z, v.y * proj.y / v.z);
    return (ndc * 0.5 + 0.5) * full_size + jitter;
}
shared vec4 tile[8][8]; // this frame's gi (rgb) and view z (a, 0: no value) per invocation

// The emission is last frame's: read where this pixel was then (motion: previous - current).
vec3 EmissionAt(ivec2 pixel) {
    const vec2 prev = vec2(pixel) + 0.5 + texelFetch(motion_tex, pixel, 0).rg;
    const ivec2 q = clamp(ivec2(prev / 4.0), ivec2(0), textureSize(emission_tex, 0) - 1);
    return texelFetch(emission_tex, q, 0).rgb;
}
vec3 Capped(vec3 c) {
    const float m = max(c.r, max(c.g, c.b));
    return m > max_radiance ? c * (max_radiance / m) : c;
}
float IGN(vec2 p) {
    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
}

// The fire lights' irradiance at `origin`, from one pass over the list: every light's unshadowed
// share (power x cosine / distance^2, windowed to fire_range) is summed, and for each of fire_rays
// shadow rays (1: the history averages them; a second ray cost 0.27 ms at the stakes) one light
// is picked in proportion to it (its own number u, all picks made in the same pass) and traced; a
// ray's estimate is its light's colour x the summed weight, or 0 when blocked. A fire is no point:
// a ray traces to a random point (v) of its light's shape each frame, so the history averages an
// area light (soft shadows; swaying leaves, whose facing flips from frame to frame, do not
// strobe): a base is a tall upright cylinder (base_size, base_height), a spark a sphere
// (spark_size). The cosine is wrapped (fire_wrap): a big light reaches round thin things.
const uint MaxPicks = 8u;
float Wrapped(vec3 N, vec3 d, float inv_len) {
    return clamp((dot(N, d) * inv_len + fire_wrap) / (1.0 + fire_wrap), 0.0, 1.0);
}
vec3 FireLights(vec3 N, vec3 origin, ivec2 fp) {
    const uint picks = clamp(fire_rays, 1u, min(rays, MaxPicks));
    const uint listed = uint(texelFetch(lights_tex, ivec2(0, 5), 0).x);
    float u[MaxPicks], picked_w[MaxPicks];
    vec3 picked_power[MaxPicks], picked_d[MaxPicks];
    float picked_kind[MaxPicks]; // the list's w: 1 a spark, 2 a base, 3 and 4 a large fire's
    for (uint r = 0u; r < MaxPicks; ++r) {
        u[r] = IGN(vec2(fp) + (float(frame % 16u) + float(r) * 16.0) * 3.141593 + 17.0);
        picked_w[r] = 0.0;
    }
    float total = 0.0;
    const float range2 = fire_range * fire_range;
    for (uint i = 0u; i < listed; ++i) {
        const vec4 a = texelFetch(lights_tex, ivec2(i, 3), 0);
        const vec4 h = vec4(a.xyz, 1.0);
        const vec3 d = vec3(dot(view[0], h), dot(view[1], h), dot(view[2], h)) - origin;
        const float dist2 = dot(d, d);
        if (dist2 >= range2) {
            continue;
        }
        const float cosine = Wrapped(N, d, inversesqrt(max(dist2, 1e-6)));
        if (cosine <= 0.0) {
            continue;
        }
        const float window = 1.0 - dist2 / range2;
        const vec3 power = texelFetch(lights_tex, ivec2(i, 4), 0).rgb;
        const float w = dot(power, vec3(0.2126, 0.7152, 0.0722)) * (cosine * window * window / max(dist2, 0.25));
        if (w <= 0.0) {
            continue;
        }
        total += w;
        // Each ray's number decides for the whole stream: keep this light with probability w / total.
        const float p = w / total;
        for (uint r = 0u; r < MaxPicks; ++r) {
            if (r >= picks) {
                break;
            }
            if (u[r] < p) {
                u[r] /= p;
                picked_w[r] = w;
                picked_power[r] = power;
                picked_d[r] = d;
                picked_kind[r] = a.w;
            } else {
                u[r] = (u[r] - p) / (1.0 - p);
            }
        }
    }
    if (total <= 0.0) {
        return vec3(0.0);
    }
    // The world's up in view space (the view rows' y) and two directions across it.
    const vec3 up = normalize(vec3(view[0].y, view[1].y, view[2].y));
    const vec3 side = abs(up.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 T = normalize(cross(side, up));
    const vec3 B = cross(up, T);
    vec3 lit = vec3(0.0);
    for (uint r = 0u; r < picks; ++r) {
        if (picked_w[r] <= 0.0) {
            continue;
        }
        const float f = float(frame % 16u) + float(r) * 16.0;
        const vec3 v = vec3(IGN(vec2(fp) + f * 2.236068 + 31.0), IGN(vec2(fp.yx) + f * 4.123106 + 7.0),
                            IGN(vec2(fp) * 1.3 + f * 6.244998 + 3.0));
        const float phi = 2.0 * PI * v.x;
        vec3 to;
        const bool large = picked_kind[r] > 2.5;
        if (picked_kind[r] == 2.0 || picked_kind[r] == 4.0) { // a point of the base's cylinder
            const float radius = large ? large_base_size : base_size, height = large ? large_base_height : base_height;
            to = picked_d[r] + (T * cos(phi) + B * sin(phi)) * (radius * sqrt(v.y)) + up * (height * (v.z - 0.4));
        } else { // a point of the spark's sphere
            const float cos_t = 1.0 - 2.0 * v.y, sin_t = sqrt(max(1.0 - cos_t * cos_t, 0.0));
            to = picked_d[r] + (T * (cos(phi) * sin_t) + B * (sin(phi) * sin_t) + up * cos_t) *
                                   ((large ? large_spark_size : spark_size) * pow(v.z, 1.0 / 3.0));
        }
        const float dist2 = dot(to, to);
        const float inv_dist = inversesqrt(max(dist2, 1e-6));
        const float window = max(1.0 - dist2 / range2, 0.0);
        const vec3 c = picked_power[r] * (Wrapped(N, to, inv_dist) * window * window / max(dist2, 0.25));
        rayQueryEXT q;
        rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsCullNoOpaqueEXT, 0xFF,
                              origin, 0.0, to * inv_dist, max(dist2 * inv_dist - 0.1, 0.0));
        while (rayQueryProceedEXT(q)) {
        }
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            lit += c * (total / picked_w[r]);
        }
    }
    return lit / float(max(picks, 1u));
}

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 lp = ivec2(gl_LocalInvocationID.xy);
    const bool inside = hp.x < int(half_size.x) && hp.y < int(half_size.y);
    const ivec2 fp = hp * 2 + 1;
    const float depth = inside ? texelFetch(depth_tex, fp, 0).r : 1.0;
    if (depth >= 1.0) {
        tile[lp.y][lp.x] = vec4(0.0);
        barrier();
        if (inside) {
            imageStore(gi_img, hp, vec4(0.0, 0.0, 0.0, 1e9));
        }
        return;
    }
    const vec3 P = ViewPos(vec2(fp) + 0.5, depth);
    const vec3 nw = normalize(texelFetch(normal_tex, fp, 0).xyz * 2.0 - 1.0);
    vec3 N = normalize(vec3(dot(view[0].xyz, nw), dot(view[1].xyz, nw), dot(view[2].xyz, nw)));
    if (dot(N, -P) < 0.0) {
        N = -N;
    }
    // Off the surface by a little more than the depth buffer's error at this distance.
    const float dist = length(P);
    const vec3 origin = P + N * (0.02 + 0.002 * dist);
    const vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    const vec3 T = normalize(cross(up, N));
    const vec3 B = cross(N, T);
    const float n0 = IGN(vec2(fp) + float(frame % 16u) * 5.588238);
    const float n1 = IGN(vec2(fp.yx) + float(frame % 16u) * 1.618034);

    vec3 gi = vec3(0.0);
    float seen = 0.0, hidden = 0.0, cached = 0.0;
    for (uint r = 0u; r < rays; ++r) {
        const float u = fract(n0 + float(r) / float(rays));
        const float v = fract(n1 + float(r) * 0.7548776662);
        const float phi = 2.0 * PI * v;
        const vec3 dir = T * (cos(phi) * sqrt(u)) + B * (sin(phi) * sqrt(u)) + N * sqrt(1.0 - u);
        rayQueryEXT q;
        // The foliage geometry (non-opaque) is skipped: its quads would be solid walls of light.
        rayQueryInitializeEXT(q, scene, gl_RayFlagsCullNoOpaqueEXT, 0xFF, origin, 0.0, dir, radius);
        while (rayQueryProceedEXT(q)) {
        }
        if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            continue; // open sky within the radius: the game's ambient covers it
        }
        const float t = rayQueryGetIntersectionTEXT(q, true);
        const float falloff = clamp(1.0 - t / radius, 0.0, 1.0);
        const vec3 H = origin + dir * t;
        const vec2 sp = ScreenPos(H);
        bool visible = H.z * P.z > 0.0 && all(greaterThanEqual(sp, vec2(0.0))) &&
                       all(lessThan(sp, full_size));
        if (visible) {
            const float sz = ViewZ(texelFetch(depth_tex, ivec2(sp), 0).r);
            visible = abs(sz - H.z) <= max(0.1, 0.03 * abs(H.z));
        }
        if (visible) {
            seen += 1.0;
            gi += (Capped(texelFetch(color_tex, ivec2(sp), 0).rgb) +
                   EmissionAt(ivec2(sp)) * emission) * falloff;
            continue;
        }
        // Hidden from the camera or off screen: the surface cache's radiance, if it saw it.
        vec3 cached_radiance;
        if (SurfaceRadiance(q, surface_cache, surface_parts, surface_parts_count, cached_radiance)) {
            cached += 1.0;
            gi += Capped(cached_radiance) * falloff;
        } else {
            hidden += 1.0;
        }
    }
    gi /= float(rays);
    vec3 fire = vec3(0.0);
    if (fire_count > 0u && fire_light > 0.0) {
        fire = FireLights(N, origin, fp) * (fire_light / PI);
        gi += fire;
    }
    if (debug == 4u) { // the fire lights alone
        gi = fire;
    }
    if (debug == 2u) {
        gi = vec3(hidden, seen, cached) / float(rays);
    }
    if (debug == 3u) { // the emission image alone (the transparents' light, last frame)
        gi = texelFetch(emission_tex, fp / 4, 0).rgb * emission;
    }

    // This frame's neighbourhood (same surface: view z within 5%), for the history clip.
    tile[lp.y][lp.x] = vec4(gi, P.z);
    barrier();
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    float n = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            const ivec2 q = lp + ivec2(dx, dy);
            if (any(lessThan(q, ivec2(0))) || any(greaterThan(q, ivec2(7)))) {
                continue;
            }
            const vec4 t = tile[q.y][q.x];
            if (t.a == 0.0 || abs(t.a - P.z) > 0.05 * abs(P.z)) {
                continue;
            }
            m1 += t.rgb;
            m2 += t.rgb * t.rgb;
            n += 1.0;
        }
    }
    m1 /= n; // n >= 1: the pixel itself
    const vec3 sigma = sqrt(max(m2 / n - m1 * m1, vec3(0.0)));
    // Wide enough for the noise of 1-2 rays, narrow enough to drop light that moved away; the
    // floor keeps flat regions from rejecting their own history.
    const vec3 box = clip * sigma + 0.02 * (m1 + vec3(0.05));

    vec4 result = vec4(gi, P.z);
    const vec2 motion = texelFetch(motion_tex, fp, 0).rg;
    const vec2 prev_fp = vec2(fp) + 0.5 + motion;
    const ivec2 prev_hp = ivec2(floor(prev_fp / 2.0));
    if (inside && all(greaterThanEqual(prev_hp, ivec2(0))) && all(lessThan(prev_hp, ivec2(half_size)))) {
        const vec4 prev = texelFetch(prev_gi_tex, prev_hp, 0);
        if (abs(prev.a - P.z) < 0.05 * abs(P.z)) {
            result.rgb = mix(gi, clamp(prev.rgb, m1 - box, m1 + box), history);
        }
    }
    if (inside) {
        imageStore(gi_img, hp, result);
    }
}

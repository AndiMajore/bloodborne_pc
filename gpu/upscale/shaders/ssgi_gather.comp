// bbport: screen-space diffuse GI, gather at half resolution (vk_ssgi.cpp). For each pixel,
// directions in screen space are marched; a sample that rises above the horizon kept so far
// (cosine to the normal) adds its lit colour times the rise: an occlusion-aware integral of the
// visible radiance over the hemisphere. Temporal blend with the previous result, reprojected.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;   // full res, D32 0..1
layout(binding = 1) uniform texture2D normal_tex;  // full res, world normal * 0.5 + 0.5
layout(binding = 2) uniform texture2D color_tex;   // full res, lit opaque scene (RGBA16F)
layout(binding = 3) uniform texture2D motion_tex;  // full res, pixels, previous - current
layout(binding = 4) uniform texture2D prev_gi_tex; // half res, previous output
layout(binding = 5, rgba16f) uniform writeonly image2D gi_img; // half res: rgb gi, a view z
layout(binding = 6) uniform texture2D emission_tex; // quarter res, the transparents' light (last frame)

layout(push_constant) uniform Constants {
    vec4 view[3];     // world -> view, 3x4 rows
    vec4 proj;        // x scale, y scale, z scale, z offset
    vec2 full_size;   // pixels
    vec2 half_size;
    float radius;     // world units
    float history;    // 0..1 blend with the previous result
    uint frame;
    uint directions;
    uint steps;
    float emission;   // x emission_tex (0: none bound)
};

const float PI = 3.14159265;

vec3 EmissionAt(ivec2 pixel) {
    const vec2 prev = vec2(pixel) + 0.5 + texelFetch(motion_tex, pixel, 0).rg;
    const ivec2 q = clamp(ivec2(prev / 4.0), ivec2(0), textureSize(emission_tex, 0) - 1);
    return texelFetch(emission_tex, q, 0).rgb;
}
float ViewZ(float depth) {
    return proj.w / min(depth - proj.z, -1e-8);
}
vec3 ViewPos(vec2 pixel, float depth) {
    const vec2 uv = pixel / full_size;
    const vec2 ndc = uv * 2.0 - 1.0;
    const float z = ViewZ(depth);
    return vec3(ndc.x * z / proj.x, ndc.y * z / proj.y, z);
}
float IGN(vec2 p) {
    return fract(52.9829189 * fract(0.06711056 * p.x + 0.00583715 * p.y));
}

void main() {
    const ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    if (hp.x >= int(half_size.x) || hp.y >= int(half_size.y)) {
        return;
    }
    const ivec2 fp = hp * 2 + 1; // full-res pixel at the centre of this half-res texel
    const float depth = texelFetch(depth_tex, fp, 0).r;
    if (depth >= 1.0) {
        imageStore(gi_img, hp, vec4(0.0, 0.0, 0.0, 1e9));
        return;
    }
    const vec3 P = ViewPos(vec2(fp) + 0.5, depth);
    const vec3 nw = normalize(texelFetch(normal_tex, fp, 0).xyz * 2.0 - 1.0);
    vec3 N = normalize(vec3(dot(view[0].xyz, nw), dot(view[1].xyz, nw), dot(view[2].xyz, nw)));
    if (dot(N, -P) < 0.0) {
        N = -N; // keep the normal facing the camera (two-sided foliage)
    }

    // Screen-space radius of the world radius at this depth, in full-res pixels.
    const float radius_px = clamp(radius * abs(proj.x) * full_size.x * 0.5 / P.z, 2.0, 256.0);
    const float noise = IGN(vec2(fp) + float(frame % 8u) * 5.588238);
    const float step_noise = IGN(vec2(fp.yx) + float(frame % 16u) * 1.618034);

    vec3 gi = vec3(0.0);
    for (uint d = 0u; d < directions; ++d) {
        const float phi = (float(d) + noise) / float(directions) * 2.0 * PI;
        const vec2 dir = vec2(cos(phi), sin(phi));
        float max_cos = 0.0; // horizon so far, as the cosine to the normal (0 = the surface plane)
        for (uint s = 0u; s < steps; ++s) {
            float t = (float(s) + step_noise) / float(steps);
            t = t * t;
            const vec2 sp = vec2(fp) + 0.5 + dir * radius_px * t;
            if (any(lessThan(sp, vec2(0.0))) || any(greaterThanEqual(sp, full_size))) {
                break;
            }
            const ivec2 si = ivec2(sp);
            const float sd = texelFetch(depth_tex, si, 0).r;
            if (sd >= 1.0) {
                continue;
            }
            const vec3 S = ViewPos(sp, sd);
            const vec3 V = S - P;
            const float dist = length(V);
            if (dist < 1e-4) {
                continue;
            }
            const float c = dot(V / dist, N);
            if (c <= max_cos) {
                continue;
            }
            const float falloff = clamp(1.0 - dist / radius, 0.0, 1.0);
            // The emission is last frame's: where this sample was then (motion: previous - current).
            const vec3 radiance = texelFetch(color_tex, si, 0).rgb +
                                  EmissionAt(si) * emission;
            gi += radiance * (c - max_cos) * falloff;
            max_cos = c;
        }
    }
    gi /= float(directions);

    // Temporal: the previous result where this pixel was last frame.
    vec4 result = vec4(gi, P.z);
    const vec2 motion = texelFetch(motion_tex, fp, 0).rg;
    const vec2 prev_fp = vec2(fp) + 0.5 + motion;
    const ivec2 prev_hp = ivec2(floor(prev_fp / 2.0));
    if (all(greaterThanEqual(prev_hp, ivec2(0))) && all(lessThan(prev_hp, ivec2(half_size)))) {
        const vec4 prev = texelFetch(prev_gi_tex, prev_hp, 0);
        if (abs(prev.a - P.z) < 0.05 * P.z) {
            result.rgb = mix(gi, prev.rgb, history);
        }
    }
    imageStore(gi_img, hp, result);
}
